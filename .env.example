# =============================================================================
# NexOPS Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# For Docker Compose local development, use the internal service name:
# POSTGRES_PASSWORD must be set to a strong random value (generate with: openssl rand -base64 32)
POSTGRES_PASSWORD=your_strong_random_password_here
DATABASE_URL=postgresql://nexops:${POSTGRES_PASSWORD}@postgres:5432/nexops?schema=public
# For external PostgreSQL, use a full connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# -----------------------------------------------------------------------------
# Clerk Authentication (REQUIRED - get keys from https://dashboard.clerk.com)
# -----------------------------------------------------------------------------
# Public key safe to expose to browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Secret key MUST be kept server-side only
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# -----------------------------------------------------------------------------
# Public Base URL of the Control Plane
# -----------------------------------------------------------------------------
# Host port published by docker compose; the app listens on 3000 inside the container.
APP_PORT=3000

# Sets the public origin agents enrol against; overrides the http://localhost:$APP_PORT default.
# PUBLIC_ORIGIN=https://nexops.example.com

# Derived from APP_PORT / PUBLIC_ORIGIN by docker compose; optional in local dev (falls back to request origin).
# For pnpm dev without docker, leave unset or set to http://localhost:$APP_PORT
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Agent Distribution Directory
# -----------------------------------------------------------------------------
# Where compiled agent binaries + install.sh are served from.
# In Docker, this is baked into the image at /app/agent-dist.
# For local development (pnpm dev), use ./agent-dist
AGENT_DIST_DIR=/app/agent-dist

# -----------------------------------------------------------------------------
# Telemetry Retention
# -----------------------------------------------------------------------------
# Days to retain TelemetrySnapshot rows before background cleanup.
# Default: 30. Each target generates ~1440 snapshots/day at 1-min heartbeats.
# Storage estimate: targets × 1440 × retention_days × ~2KB per row.
TELEMETRY_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Server Port (optional, defaults to 3000)
# -----------------------------------------------------------------------------
# PORT=3000

# -----------------------------------------------------------------------------
# Node Environment (set automatically in Docker)
# -----------------------------------------------------------------------------
# NODE_ENV=production