# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://nexops:nexops@localhost:5432/nexops?schema=public

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public base URL of the control plane (used to build agent install commands)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Directory where compiled agent binaries + install.sh are served from
AGENT_DIST_DIR=./agent-dist

# Telemetry retention window enforced by the background cleanup task
TELEMETRY_RETENTION_DAYS=30
